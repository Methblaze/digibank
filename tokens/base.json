{
  "$description": "Digi Bank 2026 primitives. The blues grow out of the 2019 palette (#23293E, #022C43, #5C7BEA); gold is the original piggy bank.",
  "color": {
    "$description": "Primitive colours. Use them through a semantic color/* token in designs; in code they are the Tailwind colour names.",
    "night": {
      "600": {
        "$type": "color",
        "$value": "#26306A"
      },
      "700": {
        "$type": "color",
        "$value": "#1A2350"
      },
      "800": {
        "$type": "color",
        "$value": "#111836"
      },
      "900": {
        "$type": "color",
        "$value": "#0A0F24"
      },
      "default": {
        "$type": "color",
        "$value": "#0A0F24"
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#F3F6FF"
    },
    "mist": {
      "$type": "color",
      "$value": "#B4BEE4"
    },
    "periwinkle": {
      "default": {
        "$type": "color",
        "$value": "#7C93FF"
      },
      "deep": {
        "$type": "color",
        "$value": "#5C7BEA"
      },
      "light": {
        "$type": "color",
        "$value": "#95A7FF",
        "$description": "Hover on periwinkle buttons."
      }
    },
    "piggy": {
      "default": {
        "$type": "color",
        "$value": "#FFC53D"
      },
      "deep": {
        "$type": "color",
        "$value": "#E8A317"
      },
      "shadow": {
        "$type": "color",
        "$value": "#B87A00"
      },
      "light": {
        "$type": "color",
        "$value": "#FFD166",
        "$description": "Hover on gold buttons."
      },
      "pale": {
        "$type": "color",
        "$value": "#FFE08A",
        "$description": "The chip on payment cards."
      }
    },
    "mint": {
      "default": {
        "$type": "color",
        "$value": "#4BE3A3"
      },
      "deep": {
        "$type": "color",
        "$value": "#2BB3A0",
        "$description": "The end of the online card gradient."
      }
    },
    "coral": {
      "$type": "color",
      "$value": "#FF8A7A"
    },
    "ice": {
      "$type": "color",
      "$value": "#A8ECFF"
    },
    "leather": {
      "default": {
        "$type": "color",
        "$value": "#F07A3C"
      },
      "deep": {
        "$type": "color",
        "$value": "#C4551F"
      },
      "light": {
        "$type": "color",
        "$value": "#F58A4F",
        "$description": "The wallet's front flap."
      }
    }
  },
  "size": {
    "radius": {
      "$description": "Corner radius: clay for raised tiles; Tailwind's own radii cover the rest.",
      "clay": {
        "$type": "dimension",
        "$value": "28px"
      }
    }
  },
  "shadow": {
    "$description": "The soft clay depth: an inner highlight, an inner shade and a drop shadow. clay for tiles, clay-sm for buttons, press for the pressed state.",
    "clay": {
      "$type": "shadow",
      "$value": [
        {
          "inset": true,
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "0px",
          "spread": "0px",
          "color": "#FFFFFF14"
        },
        {
          "inset": true,
          "offsetX": "0px",
          "offsetY": "-6px",
          "blur": "12px",
          "spread": "0px",
          "color": "#00000040"
        },
        {
          "inset": false,
          "offsetX": "0px",
          "offsetY": "10px",
          "blur": "30px",
          "spread": "0px",
          "color": "#0306148C"
        }
      ]
    },
    "clay-sm": {
      "$type": "shadow",
      "$value": [
        {
          "inset": true,
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "color": "#FFFFFF1A"
        },
        {
          "inset": true,
          "offsetX": "0px",
          "offsetY": "-3px",
          "blur": "6px",
          "spread": "0px",
          "color": "#00000040"
        },
        {
          "inset": false,
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "14px",
          "spread": "0px",
          "color": "#03061473"
        }
      ]
    },
    "press": {
      "$type": "shadow",
      "$value": [
        {
          "inset": true,
          "offsetX": "0px",
          "offsetY": "3px",
          "blur": "8px",
          "spread": "0px",
          "color": "#00000059"
        }
      ]
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Fredoka Variable",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Fredoka, for headings, buttons, numbers and eyebrows: the playful voice."
      },
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Nunito Variable",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Nunito, for body text."
      }
    },
    "weight": {
      "$description": "Font weights. Semibold carries most of the interface.",
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "size": {
      "$description": "Tailwind's type scale in px, as used in the app.",
      "xs": {
        "$type": "dimension",
        "$value": "12px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "14px"
      },
      "base": {
        "$type": "dimension",
        "$value": "16px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "18px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "20px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "24px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "30px"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "36px"
      },
      "5xl": {
        "$type": "dimension",
        "$value": "48px"
      },
      "6xl": {
        "$type": "dimension",
        "$value": "60px"
      }
    },
    "line-height": {
      "16": {
        "$type": "dimension",
        "$value": "16px"
      },
      "20": {
        "$type": "dimension",
        "$value": "20px"
      },
      "24": {
        "$type": "dimension",
        "$value": "24px"
      },
      "28": {
        "$type": "dimension",
        "$value": "28px"
      },
      "32": {
        "$type": "dimension",
        "$value": "32px"
      },
      "36": {
        "$type": "dimension",
        "$value": "36px"
      },
      "40": {
        "$type": "dimension",
        "$value": "40px"
      },
      "48": {
        "$type": "dimension",
        "$value": "48px"
      },
      "60": {
        "$type": "dimension",
        "$value": "60px"
      },
      "$description": "Line heights in px, paired with font.size as Tailwind does."
    }
  },
  "typography": {
    "$description": "Text styles, matching the Tailwind classes the app uses.",
    "display-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "{font.size.6xl}",
        "lineHeight": "{font.line-height.60}",
        "letterSpacing": "0em"
      },
      "$description": "Use for the balance on the home screen (text-6xl).",
      "$extensions": {
        "figma": {
          "name": "Display XL"
        }
      }
    },
    "display-l": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "{font.size.5xl}",
        "lineHeight": "{font.line-height.48}",
        "letterSpacing": "0em"
      },
      "$description": "Use for big amounts, such as the piggy bank total (text-5xl).",
      "$extensions": {
        "figma": {
          "name": "Display L"
        }
      }
    },
    "display-m": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "{font.size.4xl}",
        "lineHeight": "{font.line-height.40}",
        "letterSpacing": "0em"
      },
      "$description": "Use for amounts while sending (text-4xl).",
      "$extensions": {
        "figma": {
          "name": "Display M"
        }
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "{font.size.3xl}",
        "lineHeight": "{font.line-height.36}",
        "letterSpacing": "0em"
      },
      "$description": "Use for screen titles (text-3xl).",
      "$extensions": {
        "figma": {
          "name": "Title"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "{font.size.2xl}",
        "lineHeight": "{font.line-height.32}",
        "letterSpacing": "0em"
      },
      "$description": "Use for card and section headings (text-2xl).",
      "$extensions": {
        "figma": {
          "name": "Heading"
        }
      }
    },
    "subheading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "{font.size.xl}",
        "lineHeight": "{font.line-height.28}",
        "letterSpacing": "0em"
      },
      "$description": "Use for smaller headings and list titles (text-xl).",
      "$extensions": {
        "figma": {
          "name": "Subheading"
        }
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "{font.size.lg}",
        "lineHeight": "{font.line-height.28}",
        "letterSpacing": "0em"
      },
      "$description": "Use for button labels only (font-display text-lg).",
      "$extensions": {
        "figma": {
          "name": "Button"
        }
      }
    },
    "body-l": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "{font.size.lg}",
        "lineHeight": "{font.line-height.28}",
        "letterSpacing": "0em"
      },
      "$description": "Use for lead text and prominent rows (text-lg).",
      "$extensions": {
        "figma": {
          "name": "Body L"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "{font.size.base}",
        "lineHeight": "{font.line-height.24}",
        "letterSpacing": "0em"
      },
      "$description": "Use for running text (text-base).",
      "$extensions": {
        "figma": {
          "name": "Body"
        }
      }
    },
    "body-s": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "{font.size.sm}",
        "lineHeight": "{font.line-height.20}",
        "letterSpacing": "0em"
      },
      "$description": "Use for supporting text and labels (text-sm).",
      "$extensions": {
        "figma": {
          "name": "Body S"
        }
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "{font.size.xs}",
        "lineHeight": "{font.line-height.16}",
        "letterSpacing": "0em"
      },
      "$description": "Use for metadata and fine print (text-xs).",
      "$extensions": {
        "figma": {
          "name": "Caption"
        }
      }
    },
    "eyebrow": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "{font.size.sm}",
        "lineHeight": "{font.line-height.20}",
        "letterSpacing": "0.14em",
        "textCase": "uppercase"
      },
      "$description": "Use for the small uppercase label above a section (.eyebrow). Avoid for more than three words.",
      "$extensions": {
        "figma": {
          "name": "Eyebrow"
        }
      }
    }
  }
}
